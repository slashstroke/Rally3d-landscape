# Normalise line endings so the diffs stay readable on every platform.
* text=auto eol=lf

# Windows launchers need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets - never touch these.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.jar binary
*.wasm binary
*.mid binary
*.ogg binary
*.m3g binary
*.class binary
*.off binary
*.syn binary
